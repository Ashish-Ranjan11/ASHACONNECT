# ============================================================
# BENEFICIARY NAME RESOLUTION
# ============================================================

def _normalize_person_name(value: str) -> str:
    """
    Normalize beneficiary names coming from voice/STT.

    Handles:
    - Devanagari -> Latin transliteration
    - punctuation
    - possessives
    - common Hindi/Hinglish filler/suffix words
    - duplicate whitespace
    """

    value = str(value or "").strip()

    if not value:
        return ""

    # Unicode normalization
    value = unicodedata.normalize("NFKC", value)

    # Voice may produce Hindi/Devanagari names.
    # Unidecode gives us a comparable Latin representation.
    value = unidecode(value)

    value = value.lower()

    # English possessives
    value = re.sub(r"'s\b", "", value)

    # Remove punctuation but preserve spaces
    value = re.sub(r"[^a-z0-9\s]", " ", value)

    # Common conversational words that may get attached to names
    noise_words = {
        "ji",
        "jee",
        "ka",
        "ki",
        "ke",
        "ko",
        "kaa",
        "kii",
        "hai",
        "hain",
        "ka",
        "appointment",
        "report",
        "beneficiary",
        "patient",
        "record",
        "profile",
        "health",
        "status",
        "please",
    }

    words = [
        word
        for word in value.split()
        if word not in noise_words
    ]

    value = " ".join(words)

    value = re.sub(r"\s+", " ", value)

    return value.strip()


def _name_similarity(query: str, candidate: str) -> float:
    """
    Return a 0-100 similarity score.
    """

    q = _normalize_person_name(query)
    c = _normalize_person_name(candidate)

    if not q or not c:
        return 0.0

    if q == c:
        return 100.0

    # Strong result when one side contains the complete other side.
    if q in c or c in q:
        return 97.0

    return max(
        fuzz.ratio(q, c),
        fuzz.token_sort_ratio(q, c),
        fuzz.token_set_ratio(q, c),
    )


async def resolve_beneficiary(payload, authorization):
    """
    Resolve a spoken beneficiary using:
    - name
    - family_name
    - village
    - address

    Never invents beneficiary IDs.
    """

    payload = dict(payload or {})

    raw_name = str(
        payload.get("name")
        or payload.get("person_name")
        or payload.get("beneficiary_name")
        or ""
    ).strip()

    family_hint = str(
        payload.get("family_name")
        or payload.get("family")
        or payload.get("village")
        or payload.get("address")
        or ""
    ).strip()

    if not raw_name and not family_hint:
        raise ValueError(
            "Beneficiary name or family context is required"
        )

    data = await list_beneficiaries({}, authorization)

    if isinstance(data, dict):
        beneficiaries = (
            data.get("beneficiaries")
            or data.get("data")
            or data.get("items")
            or []
        )
    elif isinstance(data, list):
        beneficiaries = data
    else:
        beneficiaries = []

    if not beneficiaries:
        return {
            "found": False,
            "ambiguous": False,
            "reason": "No beneficiaries available",
        }

    def normalize(value):
        return " ".join(
            str(value or "")
            .lower()
            .replace(".", " ")
            .replace(",", " ")
            .split()
        )

    q_name = normalize(raw_name)
    q_family = normalize(family_hint)

    scored = []

    for person in beneficiaries:

        candidate_name = normalize(
            person.get("full_name")
            or person.get("name")
            or person.get("beneficiary_name")
        )

        candidate_family = normalize(
            person.get("village")
            or person.get("address")
        )

        name_score = 0
        family_score = 0

        if q_name and candidate_name:
            if q_name == candidate_name:
                name_score = 100
            elif q_name in candidate_name or candidate_name in q_name:
                name_score = 92
            else:
                q_tokens = set(q_name.split())
                c_tokens = set(candidate_name.split())

                overlap = len(q_tokens & c_tokens)

                if overlap:
                    name_score = 60 + (overlap * 10)

        if q_family and candidate_family:
            if q_family == candidate_family:
                family_score = 100
            elif (
                q_family in candidate_family
                or candidate_family in q_family
            ):
                family_score = 90
            else:
                q_tokens = set(q_family.split())
                c_tokens = set(candidate_family.split())

                overlap = len(q_tokens & c_tokens)

                if overlap:
                    family_score = 55 + (overlap * 8)

        # Name remains primary.
        final_score = (
            name_score * 0.75
            + family_score * 0.25
        )

        if not q_name:
            final_score = family_score

        scored.append(
            {
                "score": final_score,
                "name_score": name_score,
                "family_score": family_score,
                "person": person,
            }
        )

    scored.sort(
        key=lambda item: item["score"],
        reverse=True,
    )

    best = scored[0]

    if best["score"] >= 70:

        person = best["person"]

        beneficiary_id = (
            person.get("beneficiary_id")
            or person.get("id")
        )

        return {
            "found": True,
            "beneficiary_id": beneficiary_id,
            "public_id": f"ASHA-BEN-{int(beneficiary_id):06d}",
            "name": (
                person.get("full_name")
                or person.get("name")
            ),
            "family_name": (
                person.get("village")
                or person.get("address")
            ),
            "match_score": round(
                best["score"],
                1,
            ),
            "beneficiary": person,
        }

    plausible = [
        item
        for item in scored[:5]
        if item["score"] >= 45
    ]

    if plausible:
        return {
            "found": False,
            "ambiguous": True,
            "matches": [
                {
                    "beneficiary_id": (
                        item["person"].get("beneficiary_id")
                        or item["person"].get("id")
                    ),
                    "name": (
                        item["person"].get("full_name")
                        or item["person"].get("name")
                    ),
                    "family_name": (
                        item["person"].get("village")
                        or item["person"].get("address")
                    ),
                    "score": round(
                        item["score"],
                        1,
                    ),
                }
                for item in plausible
            ],
        }

    return {
        "found": False,
        "ambiguous": False,
        "name": raw_name,
        "family_name": family_hint,
    }


